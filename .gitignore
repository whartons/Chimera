# ── Chimera .gitignore ───────────────────────────────────────────────
# Public repo, private work. Tracked content stays generic & reusable.

# Private / branded workflows  ── keep these OUT of the public repo
workflows/personal/
!workflows/personal/.gitkeep
# name any private workflow *.local.json -> ignored anywhere
*.local.json

# Generated media
outputs/
!outputs/.gitkeep
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.mov
*.webm
*.gif
*.wav
*.mp3
*.flac
*.glb
*.obj
*.stl
*.ply
*.3mf
# (allow committed example thumbnails + the README demo GIF)
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.gif

# Model weights & caches  ── never commit; reference by URL in models.md
models/
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx

# Secrets / local config
.env
.env.*
!.env.example

# Internal development planning docs (kept local; not part of the public surface)
docs/superpowers/

# ComfyUI runtime cruft (if ComfyUI lives inside the repo)
ComfyUI/output/
ComfyUI/temp/
ComfyUI/input/
ComfyUI/models/
ComfyUI/user/
custom_nodes/*/
!custom_nodes/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
.ipynb_checkpoints/

# Node (if the MCP server is JS/TS)
node_modules/
dist/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Brand Kits ── pattern public, brand data private
# Everything directly under brands/ is private by default (real brands stay local)...
brands/*
# ...except the readme, the starter template, and the public showcase brand, which are
# tracked IN FULL — including their outputs/ — so the example pipeline is complete and
# reproducible for anyone who clones the repo.
!brands/README.md
!brands/_template/
!brands/_template/**
!brands/example-brand/
!brands/example-brand/**
# Never commit trained model weights, even for the example brand: large binaries —
# reproduce them from training/ + brand.yaml. (These override the broad re-include just
# above.) The example's trainer config, lora/example-brand-train-config.json, IS tracked
# as a sample: regenerate it with `python scripts/train_brand_lora.py --brand example-brand`
# (a dry run); tests/test_train_brand_lora.py checks it matches.
brands/example-brand/**/*.safetensors
brands/example-brand/**/*.ckpt
brands/example-brand/**/*.pt
brands/example-brand/**/*.pth
brands/example-brand/**/*.bin
brands/example-brand/**/*.gguf
# The re-include above beats the global secret rules, so restate them for the example brand.
brands/example-brand/**/.env
brands/example-brand/**/.env.*
brands/example-brand/**/*.local.json

# Test artifacts (coverage.xml embeds the absolute source path)
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# Secret-bearing files under conventional names (never tracked; push protection and the pre-commit
# detect-private-key hook catch key material, not these)
.envrc
.netrc
.npmrc
.pypirc
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
service-account*.json
**/secrets.yaml
**/secrets.yml
