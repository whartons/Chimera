# Copy to .env (gitignored) and fill in. Leave blank what you do not use.
# NOTE: the MCP server reads these from your shell/OS environment, not from this
# file directly — `.env` is for your own loading convenience. Chimera's CLI and agent loop
# don't load it either: export what you need in your shell first. Never commit secrets.

# ComfyUI instance the comfyui-mcp bridge drives: only .mcp.json reads it. The `chimera` CLI and
# auto_generate.py ignore it; they default to http://127.0.0.1:8000 and take --comfy-url instead
# (pass --comfy-url http://127.0.0.1:8188 on a manual install).
# ComfyUI Desktop defaults to port 8000; a manual `python main.py` install uses 8188.
COMFYUI_URL=http://127.0.0.1:8000

# Optional: full path to the Blender / FreeCADCmd executable for headless runs (render, finalize-texture,
# cad, the mesh3d / cad loops) when it isn't on PATH. --blender-bin / --freecad-bin win; unset = PATH, then
# the default Windows install folder.
# BLENDER_BIN=
# FREECAD_BIN=

# Optional: CivitAI token for GATED model downloads via the MCP's download_model tool.
# Read by comfyui-mcp as CIVITAI_API_TOKEN. Keep the real value here (gitignored) and
# never inside the tracked .mcp.json.
CIVITAI_API_TOKEN=

# Optional API keys for API-backed nodes (e.g. Gemini LLM node)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Agent LLM layer (local Ollama by default). OpenAI-compatible /v1, so any provider works.
# The loops use up to three roles: a VISION judge (scores renders against the rubric; the default
# --backend api), a prompt rewriter (--rewrite-prompts) and FreeCAD code-gen (--pipeline cad).
# With NOTHING set, each role runs on a local Ollama model (http://127.0.0.1:11434/v1, or $OLLAMA_HOST) from a
# tier picked by your GPU's memory. The defaults were chosen on a 32 GB RTX 5090; smaller cards get lighter
# judges automatically:
#   large  (32 GB+)      judge, rewriter, code-gen: qwen3.8:27b (thinking off)
#   medium (12-24 GB)    judge + rewriter: qwen3-vl:8b-instruct   code-gen: qwen3.8:27b, partly on the CPU
#   small  (under 12 GB) judge + rewriter: qwen3-vl:4b-instruct   code-gen: qwen3.8:27b, mostly on the CPU
# Install Ollama, then pull your tier's models (`chimera doctor` prints the exact commands):
#   large:  ollama pull qwen3.8:27b
#   medium: ollama pull qwen3-vl:8b-instruct   (+ ollama pull qwen3.8:27b for the CAD loop)
#   small:  ollama pull qwen3-vl:4b-instruct   (+ ollama pull qwen3.8:27b for the CAD loop)
# Pick the tier yourself (auto | large | medium | small; the --llm-tier flag wins over this):
# CHIMERA_LLM_TIER=medium
# Ollama's own memory settings. Unset, Ollama 0.40 gives a model up to its full context (256k for the Qwen judges)
# with an f16 cache; q4_0 cuts the cache to about a quarter (the reference box runs it). The loops' GPU check reads
# these from Chimera's environment, so set them where Ollama sees them too (user environment variables on Windows,
# then restart the Ollama app):
# OLLAMA_KV_CACHE_TYPE=q4_0
# OLLAMA_CONTEXT_LENGTH=32768   # optional: pins every model's context (smaller and predictable)
# The model and endpoint settings below are optional and beat the tier (role flag > CHIMERA_<ROLE>_* >
# --llm-* > CHIMERA_LLM_* > tier). A JUDGE you set must be a NON-thinking '-instruct' VLM or a hybrid model with thinking
# off: a 'thinking' tag (e.g. qwen3-vl:8b) spends its whole token budget on reasoning and returns EMPTY content
# (the loop errors loudly when a judge does that).
# Export the vars in your shell (or load this .env yourself): the agent reads them from your shell/OS env.
# CHIMERA_LLM_BASE_URL=http://localhost:11434/v1   # unset = the local Ollama above
# Keys stay with their endpoint: CHIMERA_LLM_API_KEY goes only to CHIMERA_LLM_BASE_URL's host (to every
# role when no shared base URL is set), CHIMERA_<ROLE>_API_KEY only to that role, and OPENAI_API_KEY /
# ANTHROPIC_API_KEY only to https://api.openai.com / https://api.anthropic.com.
CHIMERA_LLM_API_KEY=
# Shared fallback model (if you run ONE model for everything). Per-role below is preferred.
CHIMERA_LLM_MODEL=

# Per-role (specific-wins over the shared vars above), each an optional override of the tier's model. A pure
# swap: set the value + `ollama pull <tag>`, no code change. Base URL falls back to CHIMERA_LLM_BASE_URL, then
# the local Ollama.
# CHIMERA_JUDGE_MODEL=qwen3-vl:8b-instruct      # vision judge: a non-thinking '-instruct' tag (or thinking off)
# CHIMERA_CODEGEN_MODEL=qwen3.8:27b             # FreeCAD code-gen (model strength matters most here)
# CHIMERA_REWRITER_MODEL=qwen3-vl:8b-instruct   # prompt rewriter (a smaller/faster model is fine)

# Thinking control (optional). Hybrid-thinking models (e.g. Qwen3.x, which Ollama >= 0.40 serves with thinking
# ON) can spend the whole token budget reasoning and return empty content. The client then retries once with
# reasoning_effort=none and keeps it for the rest of the run. Set it up front to skip that wasted first pass.
# The tier's own qwen3.8:27b already starts at none; a model you configure doesn't, so set it for one that
# thinks. Only set it for providers that accept `reasoning_effort` (Ollama, Gemini, OpenAI reasoning models).
# CHIMERA_LLM_REASONING_EFFORT=none          # every role (none | low | medium | high; unset = not sent)
# CHIMERA_CODEGEN_REASONING_EFFORT=none      # per role (CODEGEN / JUDGE / REWRITER), specific-wins

# One GPU for ComfyUI + Ollama: on Windows neither app sees the other's memory, so the loops keep them apart.
# They have ComfyUI unload its models when the card lacks room for an Ollama model, unload their Ollama models
# before each ComfyUI render and when the run ends (Ollama otherwise keeps a model resident ~5 min), and
# unload other resident Ollama models before the first render. Set this only if Ollama runs on a SECOND GPU.
# CHIMERA_KEEP_LLM_LOADED=1

# Small GPU and the CAD loop? There the 27B code-gen runs mostly on the CPU (slow). Keep the tier's judge local
# and point JUST code-gen at a hosted model (a light 9B built none of the 3 test parts it tried, so don't go
# smaller):
#   CHIMERA_CODEGEN_BASE_URL=https://openrouter.ai/api/v1
#   CHIMERA_CODEGEN_MODEL=qwen/qwen3-coder          # or any strong code model
#   CHIMERA_CODEGEN_API_KEY=<key>
# Or run the WHOLE agent layer on the cloud (no local GPU): set CHIMERA_LLM_BASE_URL to a cloud /v1 AND
# CHIMERA_LLM_MODEL (a base URL alone keeps the tier's local model name):
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai  + gemini-2.5-pro
#   OpenAI    https://api.openai.com/v1                                 + gpt-4o
#   Anthropic https://api.anthropic.com/v1                             + claude-opus-4-8
